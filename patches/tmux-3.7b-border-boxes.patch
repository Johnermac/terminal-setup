+/*
+ * Work out the type of cell when each pane draws its own complete border box.
+ * The box is drawn on the ring of cells immediately around the pane, which is
+ * the outermost ring of the pane's layout cell, so no two panes share a border
+ * cell and every pane has four corners. Cells belonging to no pane are the
+ * gaps left between neighbouring boxes.
+ */
+static int
+screen_redraw_box_cell(struct screen_redraw_ctx *ctx, int px, int py,
+    struct window_pane **wpp)
+{
+	struct client		*c = ctx->c;
+	struct window		*w = c->session->curw->window;
+	struct window_pane	*wp;
+	int			 left, right, top, bottom, sb_w;
+
+	*wpp = NULL;
+
+	TAILQ_FOREACH(wp, &w->z_index, zentry) {
+		if (!window_pane_visible(wp))
+			continue;
+
+		sb_w = 0;
+		if (window_pane_show_scrollbar(wp)) {
+			sb_w = wp->scrollbar_style.width +
+			    wp->scrollbar_style.pad;
+		}
+
+		left = wp->xoff - 1;
+		right = wp->xoff + (int)wp->sx;
+		top = wp->yoff - 1;
+		bottom = wp->yoff + (int)wp->sy;
+		if (w->sb != PANE_SCROLLBARS_OFF &&
+		    w->sb_pos == PANE_SCROLLBARS_LEFT)
+			left -= sb_w;
+		else
+			right += sb_w;
+
+		if (px < left || px > right || py < top || py > bottom)
+			continue;
+		*wpp = wp;
+
+		/* Inside the pane, or in its scrollbar. */
+		if (px > left && px < right && py > top && py < bottom)
+			return (CELL_INSIDE);
+
+		if (py == top) {
+			if (px == left)
+				return (CELL_TOPLEFT);
+			if (px == right)
+				return (CELL_TOPRIGHT);
+			return (CELL_LEFTRIGHT);
+		}
+		if (py == bottom) {
+			if (px == left)
+				return (CELL_BOTTOMLEFT);
+			if (px == right)
+				return (CELL_BOTTOMRIGHT);
+			return (CELL_LEFTRIGHT);
+		}
+		return (CELL_TOPBOTTOM);
+	}
+
+	return (CELL_OUTSIDE);
+}
