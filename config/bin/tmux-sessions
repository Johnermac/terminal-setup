#!/bin/sh

list() {
  tmux list-sessions -F '#S' | while IFS= read -r s; do
    st=" $(tmux list-panes -s -t "=$s" -F '#{@claude}' | tr '\n' ' ') "
    case "$st" in
      *" wait "*) m="?" ;;
      *" done "*) m="✓" ;;
      *" busy "*) m="●" ;;
      *) m=" " ;;
    esac
    printf '%s\t%s\n' "$m" "$s"
  done
}

preview() {
  p=$(tmux list-panes -s -t "=$1" -F '#{?@claude,#{pane_id},}' | grep -m1 .)
  [ -n "$p" ] || p=$(tmux display -p -t "=$1" '#{pane_id}')
  tmux capture-pane -ep -t "$p" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}' | tail -n "${FZF_PREVIEW_LINES:-40}"
}

case "$1" in
  list) list ;;
  preview) preview "$2" ;;
  *)
    sel=$(list | fzf --reverse --ansi --delimiter='	' --nth=2 \
      --header='enter: switch / ctrl-x: kill' \
      --preview "$0 preview {2}" --preview-window=right,65%,border-left \
      --bind "ctrl-x:execute-silent(tmux kill-session -t ={2})+reload($0 list)") || exit 0
    tmux switch-client -t "=$(printf '%s' "$sel" | cut -f2)"
    ;;
esac
