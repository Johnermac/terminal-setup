#!/bin/sh

pending() { tmux show -gqv @claude_pending; }

set_pending() {
  list=$(echo "$1" | xargs)
  tmux set -g @claude_pending "$list"
  tmux set -g @claude_count "$(echo "$list" | wc -w | tr -d ' ')"
  tmux refresh-client -S 2>/dev/null
}

pending_without() { pending | tr ' ' '\n' | grep -vxF "$1" | grep -v '^$' | tr '\n' ' '; }

unmark() { case " $(pending) " in *" $1 "*) set_pending "$(pending_without "$1")" ;; esac }

pane_alive() { tmux display -p -t "$1" '#{pane_id}' >/dev/null 2>&1; }

pane_label() { tmux display -p -t "$1" '#S:#I #W'; }

set_state() {
  if [ -n "$2" ]; then
    tmux set -p -t "$1" @claude "$2"
  else
    tmux set -pu -t "$1" @claude
  fi
  tmux refresh-client -S
} 2>/dev/null

jump_to() {
  tmux switch-client -t "$1" \; select-window -t "$1" \; select-pane -t "$1"
  set_pending "$(pending_without "$1")"
}

case "$1" in
  notify)
    [ -n "$TMUX_PANE" ] || exit 0
    p=$TMUX_PANE
    event=$(jq -r '.hook_event_name // empty' 2>/dev/null)
    viewing=$(tmux display -p -t "$p" '#{&&:#{session_attached},#{&&:#{window_active},#{pane_active}}}')
    if [ "$event" = Notification ]; then
      set_state "$p" wait
      mark="✻?"
    elif [ "$viewing" = 1 ]; then
      set_state "$p" ""
    else
      set_state "$p" "done"
      mark="✻"
    fi
    [ "$viewing" = 1 ] && exit 0
    set_pending "$p $(pending_without "$p")"
    tmux display -d 2500 "$mark $(tmux display -p -t "$p" '#S:#I')"
    ;;
  busy)
    [ -n "$TMUX_PANE" ] || exit 0
    set_state "$TMUX_PANE" busy
    unmark "$TMUX_PANE"
    ;;
  end)
    [ -n "$TMUX_PANE" ] || exit 0
    set_state "$TMUX_PANE" ""
    unmark "$TMUX_PANE"
    ;;
  seen)
    [ -n "$2" ] || exit 0
    unmark "$2"
    [ "$(tmux show -pqv -t "$2" @claude)" = "done" ] && set_state "$2" ""
    ;;
  jump)
    for p in $(pending); do
      pane_alive "$p" && {
        jump_to "$p"
        exit 0
      }
      set_pending "$(pending_without "$p")"
    done
    tmux display "no pending Claude sessions"
    ;;
  pick)
    menu=$(for p in $(pending); do
      if pane_alive "$p"; then
        printf '%s\t%s\n' "$p" "$(pane_label "$p")"
      else
        set_pending "$(pending_without "$p")"
      fi
    done)
    [ -n "$menu" ] || {
      tmux display "no pending Claude sessions"
      exit 0
    }
    sel=$(printf '%s' "$menu" | fzf --reverse --with-nth=2.. --delimiter="$(printf '\t')" \
      --header='enter: jump / ctrl-x: clear all' --bind 'ctrl-x:execute-silent('"$0"' clear)+abort') || exit 0
    jump_to "$(echo "$sel" | cut -f1)"
    ;;
  clear)
    set_pending ""
    ;;
esac
exit 0
