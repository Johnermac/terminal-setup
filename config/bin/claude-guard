#!/usr/bin/env bash

cmd=$(jq -r '.tool_input.command // empty')
[ -n "$cmd" ] || exit 0

decide() {
  jq -nc --arg d "$1" --arg r "claude-guard: $2" \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: $d, permissionDecisionReason: $r}}'
  exit 0
}

is_prod() {
  [ -n "$1" ] || return 1
  case " ${AWS_PROD_PROFILES:-} " in *" $1 "*) return 0 ;; esac
  return 1
}

flat=$(printf '%s' "$cmd" | tr -d "\"'\\\\")
read -ra words <<<"$(printf '%s' "$flat" | tr '\n\t=(){}`;|&<>' ' ')"

for w in "${words[@]}"; do
  [ "${w##*/}" = aws-vault ] && decide deny "aws-vault is the human-only breakglass path"
done

prod=""
is_prod "${AWS_PROFILE:-}" && prod=${AWS_PROFILE}
is_prod "${AWS_DEFAULT_PROFILE:-}" && prod=${AWS_DEFAULT_PROFILE}
for ((j = 0; j < ${#words[@]}; j++)); do
  w=${words[j]}
  is_prod "$w" && prod=$w
  case "$w" in
    --profile | AWS_PROFILE | AWS_DEFAULT_PROFILE)
      [ "${words[j + 1]:0:1}" = '$' ] && prod="dynamic ${words[j + 1]}"
      ;;
  esac
done

aws_read_op() {
  case "$1" in
    configure | sso | login | logout | help | sts) return 0 ;;
  esac
  case "$2" in
    describe-* | list-* | get-* | head-* | lookup-* | search-* | batch-get-* | filter-* | test-* | simulate-* | validate-* | estimate-* | preview-* | wait | help | ls | presign | tail | scan | query) return 0 ;;
  esac
  return 1
}

check_segment() {
  local -a t
  read -ra t <<<"$(printf '%s' "$1" | tr '(){}' ' ')"
  local n=${#t[@]} i c=0 w

  for ((i = 0; i < n; i++)); do
    if [ "${t[i]##*/}" = git ] && [ "${t[i + 1]:-}" = push ]; then
      for w in "${t[@]:i+2}"; do
        case "$w" in --force | -f | --force-if-includes | +*) decide ask "force push" ;; esac
      done
    fi
  done

  [ -n "$prod" ] || return 0

  while [ "$c" -lt "$n" ]; do
    case "${t[c]##*/}" in
      sudo | doas | env | command | builtin | nohup | exec | time | nice | ionice | stdbuf | timeout | xargs | -* | [0-9]* | [A-Za-z_]*=*) c=$((c + 1)) ;;
      *) break ;;
    esac
  done
  [ "${t[c]:0:1}" = '$' ] && decide ask "dynamic command ${t[c]} with prod profile $prod"

  for ((i = 0; i < n; i++)); do
    case "${t[i]##*/}" in
      aws)
        local k=$((i + 1))
        while [ "$k" -lt "$n" ]; do
          case "${t[k]}" in
            --debug | --no-cli-pager | --no-paginate | --no-verify-ssl | --no-sign-request | --cli-auto-prompt | --no-cli-auto-prompt) k=$((k + 1)) ;;
            --*=*) k=$((k + 1)) ;;
            --*) k=$((k + 2)) ;;
            *) break ;;
          esac
        done
        aws_read_op "${t[k]:-}" "${t[k + 1]:-}" || decide ask "aws ${t[k]:-} ${t[k + 1]:-} with prod profile $prod"
        ;;
      terraform | tofu)
        local k=$((i + 1))
        [[ ${t[k]:-} == -* ]] && k=$((k + 1))
        case "${t[k]:-}" in
          plan | show | output | validate | fmt | init | providers | version | graph | console | -help | -version) ;;
          state | workspace)
            case "${t[k + 1]:-}" in
              list | show) ;;
              *) decide ask "terraform ${t[k]} ${t[k + 1]:-} with prod profile $prod" ;;
            esac
            ;;
          *) decide ask "terraform ${t[k]:-} with prod profile $prod" ;;
        esac
        ;;
    esac
  done
}

while IFS= read -r seg; do
  check_segment "$seg"
done < <(printf '%s\n' "$flat" | sed -E 's/(&&|\|\||;|\||&|`|\$\(|\(|\))/\n/g')

exit 0
