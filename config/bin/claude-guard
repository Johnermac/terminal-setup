#!/usr/bin/env bash

cmd=$(jq -r '.tool_input.command // empty')
[ -n "$cmd" ] || exit 0

ask() {
  jq -nc --arg r "claude-guard: $1" \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "ask", permissionDecisionReason: $r}}'
  exit 0
}

deny() {
  jq -nc --arg r "claude-guard: $1" \
    '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $r}}'
  exit 0
}

is_prod() {
  [ -n "$1" ] || return 1
  case " ${AWS_PROD_PROFILES:-} " in *" $1 "*) return 0 ;; esac
  return 1
}

default_profile=${AWS_PROFILE:-}
if [[ $cmd =~ AWS_PROFILE=[\"\']?([A-Za-z0-9_.-]+) ]]; then
  default_profile=${BASH_REMATCH[1]}
fi

aws_read_op() {
  case "$1" in
    configure | sso | login | logout | help | sts) return 0 ;;
  esac
  case "$2" in
    describe-* | list-* | get-* | head-* | lookup-* | search-* | batch-get-* | filter-* | test-* | simulate-* | validate-* | estimate-* | preview-* | wait | help | ls | presign | tail | scan | query) return 0 ;;
  esac
  return 1
}

check_segment() {
  local -a t
  read -ra t <<<"$1"
  local i=0 n=${#t[@]} profile=$default_profile svc="" op="" tf=""

  for ((j = 0; j < n; j++)); do
    [ "${t[j]}" = --profile ] && profile=${t[j + 1]:-}
    [[ ${t[j]} == --profile=* ]] && profile=${t[j]#--profile=}
  done

  while [ "$i" -lt "$n" ]; do
    case "${t[i]}" in
      aws-vault) deny "aws-vault is the human-only breakglass path" ;;
      git)
        if [ "${t[i + 1]:-}" = push ]; then
          local w
          for w in "${t[@]:i}"; do
            case "$w" in --force | -f | --force-if-includes) ask "force push" ;; esac
          done
        fi
        ;;
      aws)
        local k=$((i + 1))
        while [ "$k" -lt "$n" ]; do
          case "${t[k]}" in
            --debug | --no-cli-pager | --no-paginate | --no-verify-ssl | --no-sign-request | --cli-auto-prompt) k=$((k + 1)) ;;
            --*=*) k=$((k + 1)) ;;
            --*) k=$((k + 2)) ;;
            *) break ;;
          esac
        done
        svc=${t[k]:-}
        op=${t[k + 1]:-}
        if ! aws_read_op "$svc" "$op" && is_prod "$profile"; then
          ask "aws $svc $op on prod profile $profile"
        fi
        ;;
      terraform | tofu)
        tf=${t[i + 1]:-}
        [[ $tf == -chdir=* ]] && tf=${t[i + 2]:-}
        case "$tf" in
          apply | destroy | import | taint | untaint | force-unlock)
            is_prod "$profile" && ask "terraform $tf on prod profile $profile"
            ;;
          state)
            case "${t[i + 2]:-}" in
              rm | mv | push | replace-provider) is_prod "$profile" && ask "terraform state ${t[i + 2]} on prod profile $profile" ;;
            esac
            ;;
        esac
        ;;
    esac
    i=$((i + 1))
  done
}

while IFS= read -r seg; do
  check_segment "$seg"
done < <(printf '%s\n' "$cmd" | sed -E 's/(&&|\|\||;|\|)/\n/g')

exit 0
