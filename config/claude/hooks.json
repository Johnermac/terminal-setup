{
  "Stop": [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/claude-tmux notify", "timeout": 5 }] }],
  "Notification": [{ "hooks": [{ "type": "command", "command": "$HOME/.local/bin/claude-tmux notify", "timeout": 5 }] }],
